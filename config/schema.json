{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "compatible" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "allowedRoots"], "properties": { "mode": { "const": "restricted" }, "allowedRoots": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "type": "string", "pattern": "^/", "maxLength": 4096 } } } }
      ]
    },
    "globalIgnore": { "type": "array", "maxItems": 1024, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "debounceMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
    "maxBatchSize": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "maxQueuedEvents": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "maxTrackedEntries": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "logLevel": { "enum": ["silent", "error", "info", "debug"] }
  }
}
